# OmniVoice Studio - environment for Docker Compose
# Copy to .env before running `docker compose up -d`:  cp .env.example .env
#
# Hugging Face model repo to load
OMNIVOICE_MODEL=k2-fsa/OmniVoice
#
# Device for inference. "cpu" is the safe default inside Docker, because Apple
# Silicon MPS is not available in Linux containers.
# On a Mac, use "mps" and run the app natively instead of with Docker
# (see README.md, "Run mode 1: native on macOS").
OMNIVOICE_DEVICE=cpu
#
# Torch dtype passed to from_pretrained. float32 is the safest choice on cpu and mps.
OMNIVOICE_DTYPE=float32
#
# Data directory inside the container. Keep this as /data for Docker, since
# docker-compose.yml mounts ./data there.
DATA_DIR=/data
